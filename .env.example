# Database connection string (e.g. Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# JWT Secret for authentication
JWT_SECRET="your-super-secret-jwt-key"

# Production API URL (for the frontend to talk to the backend, e.g. https://your-backend.onrender.com/api)
# Can be left empty or set to /api if hosting both on the same domain
VITE_API_URL="/api"

# URL of the frontend (for CORS, e.g. https://your-frontend.netlify.app)
CLIENT_URL="http://localhost:3000"

# Port for the backend server
PORT=3000
